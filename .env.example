# Optional Google OAuth integration for Amplify Auth
# Configure these only when you want the Google login button enabled.
GOOGLE_CLIENT_ID_SECRET_NAME=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET_SECRET_NAME=GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_CALLBACK_URLS=http://localhost:5173/
GOOGLE_OAUTH_LOGOUT_URLS=http://localhost:5173/
